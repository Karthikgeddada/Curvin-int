# OpenRouter API Key
# Get your free key at https://openrouter.ai/keys
# Copy this file to .env and replace the placeholder below:
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google Gemini API Key (sentiment engine)
# Get your free key at https://aistudio.google.com/apikey
# When a real key is set, sentiment analysis uses Gemini instead of FinBERT
# (no 500MB model download; ideal for light deployments).
GEMINI_API_KEY=your-key-here

# Optional: force a sentiment engine ('gemini' or 'finbert'). Auto-detects if unset.
#SENTIMENT_PROVIDER=gemini

# Optional: Gemini model (default: gemini-flash-lite-latest, cheapest)
#GEMINI_MODEL=gemini-flash-lite-latest

# Deep read: how many top articles get their FULL text fetched and scored
# (0 disables). Some sites block scraping — blocked articles silently fall
# back to the headline + snippet.
#DEEP_READ_LIMIT=15

# Persistence (Supabase Postgres) — market history survives restarts.
# Create a free project at supabase.com, then copy the Connection Pooling
# URI (Project Settings → Database → Connection string → URI, port 6543) and
# paste it as DATABASE_URL. Leave unset to run without persistence.
#DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Web deployment (FastAPI on Render + webui on Vercel)
# Optional: lock CORS to your Vercel frontend URL (comma-separated; default *)
#ALLOWED_ORIGIN=https://your-app.vercel.app